# Copy to .env.local (gitignored). Never commit real values.

# Neon Postgres (pooled or direct connection string)
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/qrstudio?sslmode=require

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Super admin: set only here or in Vercel env. Never put the real value in code or docs.
SUPER_ADMIN_EMAIL=superadmin@example.com
# Keyed-hash pepper for emails and IPs (min 16 chars). Changing it breaks lookups.
HASH_PEPPER=replace-with-random-32-chars-minimum

APP_URL=http://localhost:3000

# Microsoft Clarity project ID (heatmaps and recordings). Leave empty to turn off.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Razorpay TEST mode only. Dummy values are fine for local testing.
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_test_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret

# Price per credit in paise (1000 = Rs 10)
CREDIT_PRICE_PAISE=1000

# Needed when running `next start` outside Vercel (for Auth.js host checks)
AUTH_TRUST_HOST=true
